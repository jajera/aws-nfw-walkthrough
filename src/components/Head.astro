---
/**
 * Starlight Head override: social card + icon fallbacks, and GA4 in production
 * builds only (matches guides/gitprofile: no analytics during `astro dev`).
 */
const { head } = Astro.locals.starlightRoute;
const gaId = "G-6GP64SX615";
const enableAnalytics = import.meta.env.PROD;

/** Base-aware path for a file in `public/`. */
const asset = (file: string) =>
  `${import.meta.env.BASE_URL}${file}`.replace(/\/{2,}/g, "/");

/** Absolute URL for the same, as required by OpenGraph consumers. */
const absolute = (file: string) => new URL(asset(file), Astro.site).href;

const ogImage = absolute("og.png");
const ogImageAlt =
  "AWS NFW Walkthrough — dual-hub Transit Gateway and Network Firewall across Sydney and Auckland.";

// Drop any og:image / twitter:image Starlight may have injected so ours wins.
const filteredHead = head.filter(
  ({ tag, attrs }) =>
    !(
      tag === "meta" &&
      (attrs?.property === "og:image" || attrs?.name === "twitter:image")
    ),
);
---

{/* PNG fallback first: Starlight's SVG favicon follows, so browsers that
    support SVG pick the later, sharper one. */}
<link rel="icon" type="image/png" sizes="32x32" href={asset("favicon-32.png")} />
<link rel="apple-touch-icon" sizes="180x180" href={asset("apple-touch-icon.png")} />

{filteredHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{
  enableAnalytics && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", gaId);
      </script>
    </>
  )
}
